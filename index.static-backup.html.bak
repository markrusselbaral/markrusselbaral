<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">

  <!-- SEO -->
  <title>Mark Russel Baral | Full-Stack Web Developer</title>
  <meta name="description" content="Mark Russel Baral — full-stack web developer specializing in modern front-end interfaces and robust back-end systems.">
  <meta name="author" content="Mark Russel Baral">
  <meta name="keywords" content="Mark Russel Baral, Russel Mark Baral, web developer, full-stack developer, portfolio">

  <link rel="icon" type="image/png" href="assets/img/favicon.png">
  <link rel="shortcut icon" href="assets/img/favicon.ico">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,200;0,300;0,400;0,600;0,700;0,900;1,200;1,300;1,400;1,600;1,700;1,900&display=swap" rel="stylesheet">

  <!-- REFRAME stylesheet -->
  <link rel="stylesheet" type="text/css" href="assets/css/app.css">
</head>

<body>

  <!-- Loading screen -->
  <div class="loading-screen">
    <div class="inner">
      <div class="text-box"><h3>Mark Russel Baral</h3></div>
      <div class="line-frame"><div class="line"></div></div>
    </div>
  </div>

  <!-- Mobile menu button -->
  <div class="m-menu-button">
    <div class="burger">
      <div class="line"></div>
      <div class="line"></div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="m-menu">
    <div class="m-menu-inner noselect">
      <div class="head m-b-2"><p class="small">Menu</p></div>
      <ul class="main-items">
        <li><a class="scroll-to" href="#intro"><span class="ti-location-pin"></span><p class="small">Home</p></a></li>
        <li><a class="scroll-to" href="#about"><span class="ti-user"></span><p class="small">About</p></a></li>
        <li><a class="scroll-to" href="#skills"><span class="ti-bar-chart"></span><p class="small">Skills</p></a></li>
        <li><a class="scroll-to" href="#portfolio"><span class="ti-view-grid"></span><p class="small">Portfolio</p></a></li>
        <li><a class="scroll-to" href="#contact"><span class="ti-comments"></span><p class="small">Contact</p></a></li>
      </ul>
      <div class="head m-b-2 m-t-7"><p class="small">Social</p></div>
      <div class="social-items">
        <div class="item"><a href="https://github.com/markrusselbaral/" target="_blank" rel="noopener"><span class="ti-github"></span></a></div>
        <div class="item"><a href="#" target="_blank" rel="noopener"><span class="ti-linkedin"></span></a></div>
        <div class="item"><a href="mailto:nullcracker04@gmail.com"><span class="ti-email"></span></a></div>
      </div>
    </div>
  </div>

  <div id="main">

    <!-- Fixed left content / portrait -->
    <div class="left-content noselect">
      <div class="inner-content">
        <div class="name">
          <p class="small color-white">Mark Russel Baral</p>
          <div class="seperator-line"></div>
        </div>
        <div class="picture-box">
          <div class="picture" style="background-image:url(assets/img/developer.gif);"></div>
        </div>
        <div class="frame-1 frame"></div>
        <div class="frame-2 frame"></div>
        <div class="frame-3 frame"></div>
      </div>
    </div>

    <!-- Scrollable right content -->
    <div class="right-content">
      <div class="inner-content">
        <div class="section-container">

          <!-- Intro -->
          <div class="section height-100 y-center" style="padding-bottom:2rem" id="intro">
            <div class="container">
              <p class="tag m-b-4">INTRODUCTION</p>
              <h1 class="m-b-5 m-l-3">I'm a Full-Stack Web Developer &amp; Software Engineer</h1>
              <div class="seperator-line"></div>
            </div>
          </div>

          <!-- About -->
          <div class="section" style="padding-bottom:26rem" id="about">
            <div class="container">
              <p class="tag m-b-3 scroll-animation">ABOUT</p>
              <h3 class="m-b-4 m-l-1 scroll-animation">Building seamless experiences,<br>from interface to infrastructure.</h3>
              <div class="seperator-line m-b-4 scroll-animation"></div>
              <p class="scroll-animation">Hello! I'm Mark, a versatile web developer proficient in both front-end and back-end technologies. On the front-end I specialize in crafting visually engaging, responsive interfaces with HTML, CSS, and JavaScript, translating design concepts into pixel-perfect, interactive websites. On the back-end I focus on server-side scripting and database design, building robust infrastructures that power dynamic web applications.</p>
              <p class="m-t-4 scroll-animation">My full-stack proficiency lets me integrate the user interface tightly with the back-end, resulting in cohesive, maintainable solutions. I'm always eager to bring a holistic approach to new projects and collaborate with teams to ship exceptional digital experiences.</p>
            </div>
          </div>

          <!-- Skills -->
          <div class="section" style="padding-bottom:20rem" id="skills">
            <div class="container">
              <p class="tag m-b-3 scroll-animation">SKILLS</p>
              <h3 class="m-b-4 m-l-1 scroll-animation">The stack I build with.</h3>
              <div class="seperator-line m-b-4 scroll-animation"></div>
              <p class="m-b-4 scroll-animation">Technologies I reach for across the full development lifecycle &mdash;<br>from languages and frameworks to tooling.</p>

              <ul class="accordion" data-active-index="false" data-slide-Speed="200">
                <li class="accordion-item scroll-animation">
                  <div><h5>Languages</h5><div class="icon"></div></div>
                  <div><p>PHP &middot; Java &middot; C# &middot; JavaScript &mdash; my go-to languages for systems programming, software engineering, and data analysis.</p></div>
                </li>
                <li class="accordion-item scroll-animation">
                  <div><h5>Front-End</h5><div class="icon"></div></div>
                  <div><p>Vue.js &middot; Bootstrap &middot; HTML5 &middot; CSS3 &middot; WordPress &mdash; my preferred technologies for front-end development and component design.</p></div>
                </li>
                <li class="accordion-item scroll-animation">
                  <div><h5>Back-End</h5><div class="icon"></div></div>
                  <div><p>Node.js &middot; Express &middot; MySQL &middot; Laravel &mdash; my preferred technologies for back-end programming and database architecture.</p></div>
                </li>
                <li class="accordion-item scroll-animation">
                  <div><h5>Tools</h5><div class="icon"></div></div>
                  <div><p>Git &middot; Visual Studio &middot; GitHub &middot; Docker &mdash; my favorite tools for version control, code editing, and container orchestration.</p></div>
                </li>
              </ul>

              <div class="m-t-7">
                <div class="skill-bar scroll-animation">
                  <div class="head noselect"><h5>HTML / CSS</h5></div>
                  <div class="bar m-b-2">
                    <div class="fill" style="width: 90%;"></div>
                    <div class="number-tag noselect" style="left: 90%;"><p class="small">90%</p></div>
                  </div>
                </div>
                <div class="skill-bar m-b-2 scroll-animation">
                  <div class="head noselect"><h5>JavaScript</h5></div>
                  <div class="bar">
                    <div class="fill" style="width: 80%;"></div>
                    <div class="number-tag noselect" style="left: 80%;"><p class="small">80%</p></div>
                  </div>
                </div>
                <div class="skill-bar m-b-2 scroll-animation">
                  <div class="head noselect"><h5>Laravel / PHP</h5></div>
                  <div class="bar">
                    <div class="fill" style="width: 85%;"></div>
                    <div class="number-tag noselect" style="left: 85%;"><p class="small">85%</p></div>
                  </div>
                </div>
                <div class="skill-bar scroll-animation">
                  <div class="head noselect"><h5>Vue.js</h5></div>
                  <div class="bar">
                    <div class="fill" style="width: 75%;"></div>
                    <div class="number-tag noselect" style="left: 75%;"><p class="small">75%</p></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Portfolio -->
          <div class="section" style="padding-bottom:20rem" id="portfolio">
            <div class="container">
              <p class="tag m-b-3 scroll-animation">PORTFOLIO</p>
              <h3 class="m-b-4 m-l-1 scroll-animation">Selected Work</h3>
              <div class="seperator-line m-b-4 scroll-animation"></div>
              <p class="m-b-6 scroll-animation">A few projects I've designed and built, from college work<br>to full-stack applications shipped to production.</p>

              <div class="work-grid">

                <!-- E-Voting -->
                <div class="item noselect work-lightbox scroll-animation">
                  <div class="icon-button"><span class="ti-arrow-right"></span></div>
                  <div class="info"><p class="color-white">E-Voting System</p><div class="seperator-line m-t-1"></div></div>
                  <div class="cover" style="background-image: url(assets/img/voting.png);"></div>
                  <div class="lightbox-content">
                    <div class="lightbox-images">
                      <div class="item" data-image="assets/img/voting.png"></div>
                    </div>
                    <div class="info-content">
                      <h3 class="m-b-3">E-Voting System</h3>
                      <div class="seperator-line m-b-3"></div>
                      <p>A college project built to modernize and streamline the voting process. It offers a user-friendly interface for voters while ensuring secure data storage and accurate result tabulation. Built with Laravel, Bootstrap, and JavaScript.</p>
                      <p class="m-t-3"><a class="color-white" href="http://evoting.bisubilar.org/" target="_blank" rel="noopener">Visit the live project &rarr;</a></p>
                    </div>
                  </div>
                </div>

                <!-- Steno Game -->
                <div class="item noselect m-t-6 work-lightbox scroll-animation">
                  <div class="icon-button"><span class="ti-arrow-right"></span></div>
                  <div class="info"><p class="color-white">Steno Game</p><div class="seperator-line m-t-1"></div></div>
                  <div class="cover" style="background-image: url(assets/img/steno.png);"></div>
                  <div class="lightbox-content">
                    <div class="lightbox-images">
                      <div class="item" data-image="assets/img/steno.png"></div>
                    </div>
                    <div class="info-content">
                      <h3 class="m-b-3">Steno Game</h3>
                      <div class="seperator-line m-b-3"></div>
                      <p>An engaging stenography game with a Vue.js front-end and a Laravel back-end. The project showcases interactive, dynamic UX paired with Laravel's robust framework for efficient data management and server-side logic.</p>
                      <p class="m-t-3"><a class="color-white" href="https://steno-frontend.vercel.app/" target="_blank" rel="noopener">Visit the live project &rarr;</a></p>
                    </div>
                  </div>
                </div>

                <!-- Food Menu -->
                <div class="item noselect m-t-6 work-lightbox scroll-animation">
                  <div class="icon-button"><span class="ti-arrow-right"></span></div>
                  <div class="info"><p class="color-white">Food Menu App</p><div class="seperator-line m-t-1"></div></div>
                  <div class="cover" style="background-image: url(assets/img/foodMenu.png);"></div>
                  <div class="lightbox-content">
                    <div class="lightbox-images">
                      <div class="item" data-image="assets/img/foodMenu.png"></div>
                    </div>
                    <div class="info-content">
                      <h3 class="m-b-3">Food Menu App</h3>
                      <div class="seperator-line m-b-3"></div>
                      <p>An enticing food menu built with HTML, CSS, and JavaScript &mdash; HTML for structure, CSS for styling and layout, and JavaScript for interactive elements and functionality.</p>
                      <p class="m-t-3"><a class="color-white" href="https://markrusselbaral.github.io/arbain/" target="_blank" rel="noopener">Visit the live project &rarr;</a></p>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>

          <!-- Contact -->
          <div class="section" style="padding-bottom:20rem" id="contact">
            <div class="container">
              <p class="tag m-b-3 scroll-animation">CONTACT</p>
              <h3 class="m-b-4 m-l-1 scroll-animation">Let's get in touch.</h3>
              <div class="seperator-line m-b-4 scroll-animation"></div>
              <p class="m-b-6 scroll-animation">Have a project in mind or just want to say hi?<br>Reach me through any of the channels below.</p>

              <div class="resume">
                <div class="item m-b-6 scroll-animation">
                  <p class="color-white m-b-1-5 small">Email</p>
                  <p><a class="color-white" href="mailto:nullcracker04@gmail.com">nullcracker04@gmail.com</a></p>
                </div>
                <div class="item m-b-6 scroll-animation">
                  <p class="color-white m-b-1-5 small">GitHub</p>
                  <p><a class="color-white" href="https://github.com/markrusselbaral/" target="_blank" rel="noopener">github.com/markrusselbaral</a></p>
                </div>
                <div class="item scroll-animation">
                  <p class="color-white m-b-1-5 small">Résumé</p>
                  <p><a class="color-white" href="https://docs.google.com/document/d/1XvjscIgkIc5zxX7OKrV9vGr3kTurMy97/edit?usp=drive_link&amp;ouid=115284456859749556085&amp;rtpof=true&amp;sd=true" target="_blank" rel="noopener">View my résumé &rarr;</a></p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>

  <script src="assets/js/app.js"></script>
</body>
</html>
